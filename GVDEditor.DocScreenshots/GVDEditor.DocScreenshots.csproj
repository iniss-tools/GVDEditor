<Project Sdk="Microsoft.NET.Sdk">
	<!-- Generator snímok okien GVDEditora pre dokumentáciu (iniss-tools-docs).
	     Zostaví fiktívnu inštaláciu INISS, otvorí v nej okná programu a uloží ich
	     ako PNG vo svetlom aj tmavom režime. Spúšťa sa ručne, nie je súčasťou inštalácie. -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<!-- konzolová aplikácia, aby priebeh a varovania išli do terminálu; okná WinForms zobrazí aj tak -->
		<OutputType>Exe</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>GVDEditor.DocScreenshots</RootNamespace>
		<AssemblyName>GVDEditor.DocScreenshots</AssemblyName>
		<!-- titulky okien (Application.ProductName) ako v programe; konfigurácia a register
		     sa riadia názvom zostavy, takže ostávajú oddelené od GVDEditora -->
		<Product>GVDEditor</Product>
		<!-- rovnaké škálovanie ako GVDEditor, aby okná vyzerali ako v programe -->
		<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<SatelliteResourceLanguages>cs</SatelliteResourceLanguages>
		<!-- LibraryImport pre PrintWindow/DWM generuje unsafe kód -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\GVDEditor\GVDEditor.csproj" />
	</ItemGroup>
</Project>
