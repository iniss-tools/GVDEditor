<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>GVDEditor</RootNamespace>
		<AssemblyName>GVDEditor</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<StartupObject>GVDEditor.Program</StartupObject>
		<ApplicationIcon>gvd.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- Zodpovedá pôvodnému app.manifest dpiAware=true + App.config EnableWindowsFormsHighDpiAutoResizing=true
		     (system-aware, nie PerMonitorV2 - zachovaná pôvodná škálovacia logika, pozri MIGRATION_PROGRESS.md). -->
		<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
		<LangVersion>default</LangVersion>
		<!-- Bez RID kopiruje SDK do runtimes\ aj natívne knižnice pre Android, Linux a macOS
		     (ťahá ich System.IO.Ports). Pripnutie win-x64 nechá len tie windowsové.
		     SelfContained=false: RID sám o sebe od .NET 8 self-contained neznamená, ale nech je to zjavné.
		     AppendRuntimeIdentifierToOutputPath=false: inak by výstup skončil v podpriečinku win-x64
		     a rozbil by cesty v gvdinstaller.iss aj v cieli CopyELISBridge. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<!-- Slovenčina je v hlavnej zostave, preložená je len čeština. Ostatné jazyky sú
		     satelity balíčkov (System.ServiceModel a spol.), ktoré program nikdy nezobrazí. -->
		<SatelliteResourceLanguages>cs</SatelliteResourceLanguages>
	</PropertyGroup>
	<!-- ClickOnce publish nastavenia (pôvodne pre .NET Framework) - zachované pre kontinuitu,
	     ale `dotnet publish` ClickOnce flow pre SDK-style .NET treba pred použitím overiť samostatne. -->
	<PropertyGroup>
		<PublishUrl>ftp://endora.endora.cz/iniss.6f.sk/web/apps/GVDEditor/</PublishUrl>
		<Install>true</Install>
		<InstallFrom>Web</InstallFrom>
		<UpdateEnabled>true</UpdateEnabled>
		<UpdateMode>Foreground</UpdateMode>
		<UpdateInterval>7</UpdateInterval>
		<UpdateIntervalUnits>Days</UpdateIntervalUnits>
		<UpdatePeriodically>false</UpdatePeriodically>
		<UpdateRequired>false</UpdateRequired>
		<MapFileExtensions>true</MapFileExtensions>
		<InstallUrl>http://iniss.6f.sk/apps/GVDEditor/</InstallUrl>
		<CreateWebPageOnPublish>true</CreateWebPageOnPublish>
		<WebPage>publish.htm</WebPage>
		<ApplicationRevision>2</ApplicationRevision>
		<ApplicationVersion>1.9.0.*</ApplicationVersion>
		<UseApplicationTrust>false</UseApplicationTrust>
		<CreateDesktopShortcut>true</CreateDesktopShortcut>
		<ManifestCertificateThumbprint>B97ABAA6C3D241E476C79AE2D5335E05C1E4C140</ManifestCertificateThumbprint>
		<ManifestKeyFile>iniss6f.pfx</ManifestKeyFile>
		<!-- GenerateManifests/SignManifests vypnuté: úloha GenerateTrustInfo (ClickOnce) nie je podporovaná
		     .NET Core MSBuildom (MSB4803, rovnaký limit ako ResolveComReference). ClickOnce `dotnet publish`
		     flow pre SDK-style .NET treba overiť/zapnúť samostatne (viď MIGRATION_PROGRESS.md), mimo dotnet build. -->
		<GenerateManifests>false</GenerateManifests>
		<SignManifests>false</SignManifests>
		<TargetZone>LocalIntranet</TargetZone>
		<SignAssembly>false</SignAssembly>
	</PropertyGroup>
	<ItemGroup>
