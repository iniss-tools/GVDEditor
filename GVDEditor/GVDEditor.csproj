	<!-- ELISBridge je samostatny x86 proces (TT.dll je 32-bitova), preto sa nelinkuje
	     ako referencia, ale iba zostavi a skopiruje vedla GVDEditor.exe. -->
	<Target Name="BuildELISBridge" BeforeTargets="Build">
		<MSBuild Projects="..\ELISBridge\ELISBridge.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
	</Target>
	<Target Name="CopyELISBridge" AfterTargets="Build">
		<ItemGroup>
			<!-- nielen .exe: apphost potrebuje vedla seba aj ELISBridge.dll, .runtimeconfig.json
			     a .deps.json, inak sa nespusti. Glob az za behu targetu, aby zachytil to,
			     co prave vyrobil BuildELISBridge. -->
			<ELISBridgeOutput Include="..\ELISBridge\bin\$(Configuration)\net10.0-windows\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(ELISBridgeOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
	</Target>
