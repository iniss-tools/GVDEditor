<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>GVDEditor</RootNamespace>
		<AssemblyName>GVDEditor</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<StartupObject>GVDEditor.Program</StartupObject>
		<ApplicationIcon>gvd.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<LangVersion>default</LangVersion>
		<!-- Bez RID kopiruje SDK do runtimes\ aj natívne knižnice pre Android, Linux a macOS
		     (ťahá ich System.IO.Ports). Pripnutie win-x64 nechá len tie windowsové.
		     SelfContained=false: RID sám o sebe od .NET 8 self-contained neznamená, ale nech je to zjavné.
		     AppendRuntimeIdentifierToOutputPath=false: inak by výstup skončil v podpriečinku win-x64
		     a rozbil by cesty v gvdinstaller.iss aj v cieli CopyELISBridge. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<!-- Slovenčina je v hlavnej zostave, preložená je len čeština. Ostatné jazyky sú
		     satelity balíčkov (System.ServiceModel a spol.), ktoré program nikdy nezobrazí. -->
		<SatelliteResourceLanguages>cs</SatelliteResourceLanguages>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="AutoCompleteMenu-ScintillaNET" Version="2.1.1" />
		<!-- len pre Rider ([UsedImplicitly]); atributy su [Conditional], za behu sa DLL nepotrebuje -->
		<PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" ExcludeAssets="runtime" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="NAudio.WinForms" Version="2.2.1" />
		<!-- Balík "Scintilla5.NET" (bez bodky) je silne pomenovaný s iným PublicKeyToken ako to, proti čomu je
		     skompilovaný AutoCompleteMenu-ScintillaNET 2.1.1 (referencuje "Scintilla.NET" bez silného mena) -
		     s ním by autocomplete zlyhal pri runtime type-loade. Balík "Scintilla.NET" (s bodkou, VPKSoft)
		     je nepomenovane-silný fork zo stejnej vetvy, kompatibilný s AutoCompleteMenu. -->
		<PackageReference Include="Scintilla.NET" Version="5.3.2.9" />
	</ItemGroup>
	<ItemGroup>
		<!-- ElisData.cs je zdieľaný medzi GVDEditor (tento proces) a ELISBridge (samostatný x86 proces) -->
		<Compile Include="..\ELISBridge\ElisData.cs" Link="Integration\ElisData.cs" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="gvd.ico" />
		<!-- Licencie sú v koreni repozitára, spoločné pre celý projekt.
		     Link určuje, kam sa skopírujú vo výstupe - bez neho by skončili v jeho koreni. -->
		<Content Include="..\Licences\GPLv3.txt" Link="Licences\GPLv3.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\Licences\LICENCE.txt" Link="Licences\LICENCE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
