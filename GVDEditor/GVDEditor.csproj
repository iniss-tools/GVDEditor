<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>GVDEditor</RootNamespace>
		<AssemblyName>GVDEditor</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<StartupObject>GVDEditor.Program</StartupObject>
		<ApplicationIcon>gvd.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- Zodpovedá pôvodnému app.manifest dpiAware=true + App.config EnableWindowsFormsHighDpiAutoResizing=true
		     (system-aware, nie PerMonitorV2 - zachovaná pôvodná škálovacia logika, pozri MIGRATION_PROGRESS.md). -->
		<ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
		<LangVersion>default</LangVersion>
	</PropertyGroup>
	<!-- ClickOnce publish nastavenia (pôvodne pre .NET Framework) - zachované pre kontinuitu,
	     ale `dotnet publish` ClickOnce flow pre SDK-style .NET treba pred použitím overiť samostatne. -->
	<PropertyGroup>
		<PublishUrl>ftp://endora.endora.cz/iniss.6f.sk/web/apps/GVDEditor/</PublishUrl>
		<Install>true</Install>
		<InstallFrom>Web</InstallFrom>
		<UpdateEnabled>true</UpdateEnabled>
		<UpdateMode>Foreground</UpdateMode>
		<UpdateInterval>7</UpdateInterval>
		<UpdateIntervalUnits>Days</UpdateIntervalUnits>
		<UpdatePeriodically>false</UpdatePeriodically>
		<UpdateRequired>false</UpdateRequired>
		<MapFileExtensions>true</MapFileExtensions>
		<InstallUrl>http://iniss.6f.sk/apps/GVDEditor/</InstallUrl>
		<CreateWebPageOnPublish>true</CreateWebPageOnPublish>
		<WebPage>publish.htm</WebPage>
		<ApplicationRevision>2</ApplicationRevision>
		<ApplicationVersion>1.8.0.*</ApplicationVersion>
		<UseApplicationTrust>false</UseApplicationTrust>
		<CreateDesktopShortcut>true</CreateDesktopShortcut>
		<ManifestCertificateThumbprint>B97ABAA6C3D241E476C79AE2D5335E05C1E4C140</ManifestCertificateThumbprint>
		<ManifestKeyFile>iniss6f.pfx</ManifestKeyFile>
		<!-- GenerateManifests/SignManifests vypnuté: úloha GenerateTrustInfo (ClickOnce) nie je podporovaná
		     .NET Core MSBuildom (MSB4803, rovnaký limit ako ResolveComReference). ClickOnce `dotnet publish`
		     flow pre SDK-style .NET treba overiť/zapnúť samostatne (viď MIGRATION_PROGRESS.md), mimo dotnet build. -->
		<GenerateManifests>false</GenerateManifests>
		<SignManifests>false</SignManifests>
		<TargetZone>LocalIntranet</TargetZone>
		<SignAssembly>false</SignAssembly>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="AutoCompleteMenu-ScintillaNET" Version="2.1.1" />
		<PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
		<PackageReference Include="Microsoft.Office.Interop.Excel" Version="16.0.18925.20022" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="NAudio.WinForms" Version="2.2.1" />
		<!-- Balík "Scintilla5.NET" (bez bodky) je silne pomenovaný s iným PublicKeyToken ako to, proti čomu je
		     skompilovaný AutoCompleteMenu-ScintillaNET 2.1.1 (referencuje "Scintilla.NET" bez silného mena) -
		     s ním by autocomplete zlyhal pri runtime type-loade. Balík "Scintilla.NET" (s bodkou, VPKSoft)
		     je nepomenovane-silný fork zo stejnej vetvy, kompatibilný s AutoCompleteMenu. -->
		<PackageReference Include="Scintilla.NET" Version="5.3.2.9" />
	</ItemGroup>
	<ItemGroup>
		<!-- ElisData.cs je zdieľaný medzi GVDEditor (tento proces) a ELISBridge (samostatný x86 proces) -->
		<Compile Include="..\ELISBridge\ElisData.cs" Link="Tools\ElisData.cs" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="gvd.ico" />
		<Content Include="Licences\GPLv3.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Licences\LICENCE.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\ExControls\ExControls\ExControls.csproj" />
		<ProjectReference Include="..\..\ToolsCore\ToolsCore\ToolsCore.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Forms\FColumnTypeSelect.cs.resx">
	    <DependentUpon>FColumnTypeSelect.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FAnalyzer.cs.resx">
	    <DependentUpon>FAnalyzer.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FEditTrain.cs.resx">
	    <DependentUpon>FEditTrain.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FELISImport.cs.resx">
	    <DependentUpon>FELISImport.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FELISStations.cs.resx">
	    <DependentUpon>FELISStations.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FGlobalSettings.cs.resx">
	    <DependentUpon>FGlobalSettings.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FImportData.cs.resx">
	    <DependentUpon>FImportData.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FLocalSettings.cs.resx">
	    <DependentUpon>FLocalSettings.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FMain.cs.resx">
	    <DependentUpon>FMain.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FNewGrafikon.cs.resx">
	    <DependentUpon>FNewGrafikon.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FRadenie.cs.resx">
	    <DependentUpon>FRadenie.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FTableCatalog.cs.resx">
	    <DependentUpon>FTableCatalog.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FTableColumnOrder.cs.resx">
	    <DependentUpon>FTableColumnOrder.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FTableLogical.cs.resx">
	    <DependentUpon>FTableLogical.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FTablePhysical.cs.resx">
	    <DependentUpon>FTablePhysical.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FTableText.cs.resx">
	    <DependentUpon>FTableText.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FTabTab.cs.resx">
	    <DependentUpon>FTabTab.cs</DependentUpon>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Forms\FWait.cs.resx">
	    <DependentUpon>FWait.cs</DependentUpon>
	  </EmbeddedResource>
	</ItemGroup>
	<!-- ELISBridge je samostatny x86 proces (TT.dll je 32-bitova), preto sa nelinkuje
	     ako referencia, ale iba zostavi a skopiruje vedla GVDEditor.exe. -->
	<Target Name="BuildELISBridge" BeforeTargets="Build">
		<MSBuild Projects="..\ELISBridge\ELISBridge.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
	</Target>
	<Target Name="CopyELISBridge" AfterTargets="Build">
		<ItemGroup>
			<ELISBridgeOutput Include="..\ELISBridge\bin\$(Configuration)\net10.0-windows\ELISBridge.exe" />
			<ELISBridgeOutput Include="..\ELISBridge\bin\$(Configuration)\net10.0-windows\ELISBridge.pdb" />
		</ItemGroup>
		<Copy SourceFiles="@(ELISBridgeOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
	</Target>
</Project>
